rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Primitive Definition
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Validation Blueprint for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['weight', 'height', 'age', 'gender', 'activityLevel', 'goal', 'accessState'])
        && data.weight is number
        && data.height is number
        && data.age is number
        && data.gender is string && (data.gender == 'M' || data.gender == 'F')
        && data.activityLevel is string && data.activityLevel in ['sedentary', 'light', 'moderate', 'active', 'very_active']
        && data.goal is string && data.goal in ['cut', 'maintain', 'bulk']
        && data.accessState is string && data.accessState in ['free', 'beta-vip'];
    }

    // Validation Blueprint for WorkoutLog
    function isValidWorkoutLog(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'day', 'duration', 'status', 'exercises'])
        && data.id is string
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() <= 100
        && data.day is string && data.day.size() <= 50
        && data.duration is string && data.duration.size() <= 50
        && data.status is string && data.status in ['completed', 'next', 'locked']
        && data.exercises is list && data.exercises.size() <= 50;
    }
    
    // Validation Blueprint for CnsLog
    function isValidCnsLog(data, userId) {
      return data.keys().hasAll(['userId', 'sleep', 'soreness', 'stress', 'score', 'status'])
        && data.userId is string && data.userId == userId
        && data.sleep is number
        && data.soreness is number
        && data.stress is number
        && data.score is number
        && data.status is string && data.status.size() <= 50;
    }

    match /users/{userId} {
      allow get, delete: if true;
      allow create, update: if isValidId(userId)
        && isValidUserProfile(incoming());
      
      match /workouts/{workoutId} {
        allow list, get, delete: if true;
        allow create, update: if isValidId(workoutId)
          && isValidWorkoutLog(incoming(), userId);
      }
      
      match /cnsLogs/{logId} {
        allow list, get, delete: if true;
        allow create, update: if isValidId(logId)
          && isValidCnsLog(incoming(), userId);
      }
      
      match /daily_stats/{dateId} {
        allow read, write: if true;
      }
    }
  }
}
